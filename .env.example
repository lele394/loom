# ── Loom configuration ───────────────────────────────────────────────
# Copy to .env for development. All values are optional except where noted.

# HTTP
PORT=8787
HOST=127.0.0.1

# Storage
LOOM_DATA_DIR=./data
# LOOM_DB_PATH=./data/loom.db
# LOOM_BACKUP_DIR=./data/backups
# LOOM_SECRET=change-me-to-a-long-random-string
LOOM_MAX_UPLOAD_MB=50
LOOM_MAX_STORAGE_GB=10

# Security (enable when serving over HTTPS behind a proxy)
LOOM_SECURE_COOKIES=false
LOOM_TRUST_PROXY=false
# LOOM_ALLOWED_ORIGIN=https://loom.example.org

# Runtime
LOOM_LOG_LEVEL=info
LOOM_WORKER_ENABLED=true
# LOOM_SKIP_PRE_MIGRATION_BACKUP=1
# LOOM_DEV_WEB_URL=http://localhost:5173
